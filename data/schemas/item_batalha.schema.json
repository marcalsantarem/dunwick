{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dunwick/item_batalha",
  "title": "Item do jogo: usável em batalha (cura) ou sem efeito (lembrança, chave). M1: poção de cura e a lembrança do Edric",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "versao",
    "nome_txt",
    "uso_batalha",
    "efeito"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^item_[a-z0-9_]+$"
    },
    "versao": {
      "type": "integer",
      "minimum": 1
    },
    "nota": {
      "type": "string"
    },
    "nome_txt": {
      "type": "string",
      "pattern": "^txt_[a-z0-9_]+$"
    },
    "uso_batalha": {
      "type": "boolean"
    },
    "alvo_tipo": {
      "enum": [
        "aliado_1",
        "aliados_todos",
        "si"
      ]
    },
    "efeito": {
      "enum": [
        "cura",
        "nenhum"
      ]
    },
    "cura_base": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "escala": {
      "type": "number",
      "minimum": 0
    },
    "tempo": {
      "type": "string",
      "pattern": "^t_[a-z_]+$"
    },
    "pose": {
      "type": "string",
      "pattern": "^bat_[a-z_]+$"
    },
    "categoria": {
      "enum": [
        "consumivel",
        "lembranca",
        "chave"
      ],
      "description": "consumivel (padrão) · lembranca/chave: sem efeito, não vendem nem se descartam"
    },
    "desc_txt": {
      "type": "string",
      "pattern": "^txt_[a-z0-9_]+$"
    },
    "valor": {
      "type": "integer",
      "minimum": 0,
      "description": "preço de venda em moedas; 0 = não vende"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "efeito": {
            "const": "cura"
          }
        },
        "required": [
          "efeito"
        ]
      },
      "then": {
        "properties": {
          "alvo_tipo": true,
          "cura_base": true,
          "escala": true,
          "tempo": true,
          "pose": true
        },
        "required": [
          "alvo_tipo",
          "cura_base",
          "escala",
          "tempo",
          "pose"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "efeito": {
            "const": "nenhum"
          }
        },
        "required": [
          "efeito"
        ]
      },
      "then": {
        "properties": {
          "uso_batalha": {
            "const": false
          }
        }
      }
    }
  ]
}
