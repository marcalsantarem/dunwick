{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dunwick/personagem",
  "title": "Herói jogável: movimento, caixas, ataques, golpe forte e esquiva em dados (dano/atributos são do 03/06)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "versao", "sprite", "movimento", "caixas", "animacoes", "ataques", "forte", "esquiva"],
  "$defs": {
    "quadros": {
      "type": "object", "additionalProperties": false, "required": ["preparacao", "ativo", "recuperacao"],
      "properties": { "preparacao": { "type": "integer", "minimum": 1 }, "ativo": { "type": "integer", "minimum": 1 }, "recuperacao": { "type": "integer", "minimum": 0 } }
    },
    "hitbox": {
      "type": "object", "additionalProperties": false, "required": ["forma", "alcance_tiles", "abertura_graus"],
      "properties": { "forma": { "enum": ["arco"] }, "alcance_tiles": { "type": "number", "exclusiveMinimum": 0, "maximum": 8 }, "abertura_graus": { "type": "number", "exclusiveMinimum": 0, "maximum": 360 } }
    },
    "ataque": {
      "type": "object", "additionalProperties": false, "required": ["id", "anim", "quadros", "janela_combo_quadros", "avanco_tiles", "hitbox"],
      "properties": {
        "id": { "type": "string", "pattern": "^atk_[a-z0-9_]+$" }, "anim": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "quadros": { "$ref": "#/$defs/quadros" }, "janela_combo_quadros": { "type": "integer", "minimum": 0 },
        "avanco_tiles": { "type": "number", "minimum": 0, "maximum": 6 }, "hitbox": { "$ref": "#/$defs/hitbox" }
      }
    }
  },
  "properties": {
    "id": { "type": "string", "pattern": "^hero_[a-z0-9_]+$" },
    "versao": { "type": "integer", "minimum": 1 },
    "nota": { "type": "string" },
    "sprite": { "type": "string", "pattern": "^[a-z]+_[a-z0-9_]+$" },
    "movimento": {
      "type": "object", "additionalProperties": false, "required": ["vel_andar", "vel_correr", "aceleracao_s", "freada_s"],
      "properties": {
        "vel_andar": { "type": "number", "exclusiveMinimum": 0, "maximum": 20 }, "vel_correr": { "type": "number", "exclusiveMinimum": 0, "maximum": 30 },
        "aceleracao_s": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }, "freada_s": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "caixas": {
      "type": "object", "additionalProperties": false, "required": ["pushbox_raio_tiles", "hurtbox_raio_tiles", "hurtbox_altura_tiles"],
      "properties": {
        "pushbox_raio_tiles": { "type": "number", "exclusiveMinimum": 0, "maximum": 2 }, "hurtbox_raio_tiles": { "type": "number", "exclusiveMinimum": 0, "maximum": 2 },
        "hurtbox_altura_tiles": { "type": "array", "prefixItems": [{ "type": "number", "minimum": 0 }, { "type": "number", "exclusiveMinimum": 0 }], "items": false, "minItems": 2 }
      }
    },
    "animacoes": {
      "type": "object", "additionalProperties": false, "required": ["parado", "andar", "correr", "dano"],
      "properties": { "parado": { "type": "string" }, "andar": { "type": "string" }, "correr": { "type": "string" }, "dano": { "type": "string" } }
    },
    "ataques": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/$defs/ataque" } },
    "forte": { "$ref": "#/$defs/ataque" },
    "esquiva": {
      "type": "object", "additionalProperties": false, "required": ["anim", "duracao_quadros", "distancia_tiles", "invencivel_quadros", "recarga_quadros"],
      "properties": {
        "anim": { "type": "string" }, "duracao_quadros": { "type": "integer", "minimum": 1 }, "distancia_tiles": { "type": "number", "exclusiveMinimum": 0, "maximum": 12 },
        "invencivel_quadros": { "type": "array", "prefixItems": [{ "type": "integer", "minimum": 0 }, { "type": "integer", "minimum": 1 }], "items": false, "minItems": 2 },
        "recarga_quadros": { "type": "integer", "minimum": 0 }
      }
    },
    "luz": {
      "type": "object", "additionalProperties": false, "required": ["cor", "intensidade", "alcance_tiles", "altura_tiles"],
      "properties": { "cor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }, "intensidade": { "type": "number", "minimum": 0 }, "alcance_tiles": { "type": "number", "exclusiveMinimum": 0 }, "altura_tiles": { "type": "number", "minimum": 0 } }
    }
  }
}
