{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dunwick/zonas_encontro",
  "title": "Encontro aleatório por passos de um mapa (13): zonas, zonas seguras, taxa e tabela de encontros",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "versao", "mapa", "ligado", "tiles_por_passo", "passos_minimos", "passos_carencia_pos_batalha", "taxa_por_passo", "zonas_seguras", "zonas_encontro"],
  "$defs": {
    "ret": { "type": "array", "prefixItems": [{ "type": "integer", "minimum": 0 }, { "type": "integer", "minimum": 0 }, { "type": "integer", "minimum": 0 }, { "type": "integer", "minimum": 0 }], "items": false, "minItems": 4 }
  },
  "properties": {
    "id": { "type": "string", "pattern": "^z_enc_[a-z0-9_]+$" },
    "versao": { "type": "integer", "minimum": 1 },
    "nota": { "type": "string" },
    "mapa": { "type": "string", "pattern": "^map_[a-z0-9_]+$" },
    "ligado": { "type": "boolean" },
    "tiles_por_passo": { "type": "number", "exclusiveMinimum": 0, "maximum": 4 },
    "passos_minimos": { "type": "integer", "minimum": 0, "maximum": 200 },
    "passos_carencia_pos_batalha": { "type": "integer", "minimum": 0, "maximum": 200 },
    "taxa_por_passo": { "type": "number", "minimum": 0, "maximum": 1 },
    "zonas_seguras": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["id", "ret"], "properties": { "id": { "type": "string", "pattern": "^z_[a-z0-9_]+$" }, "ret": { "$ref": "#/$defs/ret" } } }
    },
    "zonas_encontro": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "ret", "tabela"],
        "properties": {
          "id": { "type": "string", "pattern": "^z_[a-z0-9_]+$" },
          "ret": { "$ref": "#/$defs/ret" },
          "taxa_por_passo": { "type": "number", "minimum": 0, "maximum": 1 },
          "tabela": {
            "type": "array", "minItems": 1,
            "items": { "type": "object", "additionalProperties": false, "required": ["encontro", "peso"], "properties": { "encontro": { "type": "string", "pattern": "^enc_[a-z0-9_]+$" }, "peso": { "type": "number", "exclusiveMinimum": 0 } } }
          }
        }
      }
    }
  }
}
