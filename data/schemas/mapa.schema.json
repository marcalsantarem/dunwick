{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dunwick/mapa",
  "title": "Mapa isométrico: terreno por tiles + objetos do kit (layout é do 06)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "versao", "nome_txt", "tamanho", "legenda", "planta", "objetos", "inicio_jogador", "limites_camera"],
  "$defs": {
    "tile": { "type": "array", "prefixItems": [{ "type": "integer", "minimum": 0 }, { "type": "integer", "minimum": 0 }], "items": false, "minItems": 2 }
  },
  "properties": {
    "id": { "type": "string", "pattern": "^map_[a-z0-9_]+$" },
    "versao": { "type": "integer", "minimum": 1 },
    "nome_txt": { "type": "string", "pattern": "^txt_[a-z0-9_]+$" },
    "origem": { "type": "string" },
    "tamanho": { "type": "array", "prefixItems": [{ "type": "integer", "minimum": 1 }, { "type": "integer", "minimum": 1 }], "items": false, "minItems": 2 },
    "legenda": { "type": "object", "minProperties": 1, "propertyNames": { "type": "string", "minLength": 1, "maxLength": 1 }, "additionalProperties": { "enum": ["grama", "terra", "calcada", "musgo"] } },
    "planta": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "objetos": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "tipo"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]+(_[a-z0-9]+)*$" },
          "tipo": { "enum": ["casa", "torre_sino", "poco", "arvore", "pinheiro", "arbusto", "pedra", "lanterna", "barril", "caixote", "cerca", "inimigo"] },
          "x": { "type": "number" }, "z": { "type": "number" }, "x0": { "type": "number" }, "z0": { "type": "number" }, "x1": { "type": "number" }, "z1": { "type": "number" },
          "w": { "type": "number", "exclusiveMinimum": 0 }, "d": { "type": "number", "exclusiveMinimum": 0 },
          "rot": { "type": "number" }, "escala": { "type": "number", "exclusiveMinimum": 0 }, "seed": { "type": "integer" },
          "telhado": { "enum": ["telha", "ardosia", "musgo"] }, "janelas": { "type": "integer", "minimum": 0, "maximum": 8 }, "chamine": { "type": "boolean" }
        }
      }
    },
    "inicio_jogador": {
      "type": "object", "additionalProperties": false, "required": ["tile", "direcao"],
      "properties": { "tile": { "$ref": "#/$defs/tile" }, "direcao": { "enum": ["s", "n", "l", "o"] } }
    },
    "limites_camera": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }, { "type": "number" }], "items": false, "minItems": 4 }
  }
}
