{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dunwick/cfg_ui_batalha",
  "title": "UI da batalha por turnos (15)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "versao", "t_mensagem", "t_barra_inimigo_visivel", "vida_baixa_fracao", "acelerar_mult", "numero_altura_px", "gamepad_limiar", "palco_meia_largura_tiles", "palco_meia_profundidade_tiles"],
  "properties": {
    "id": { "const": "cfg_ui_batalha" },
    "versao": { "type": "integer", "minimum": 1 },
    "nota": { "type": "string" },
    "t_mensagem": { "type": "number", "minimum": 0.6, "maximum": 5 },
    "t_barra_inimigo_visivel": { "type": "number", "minimum": 0, "maximum": 10 },
    "vida_baixa_fracao": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
    "acelerar_mult": { "type": "number", "minimum": 1, "maximum": 4 },
    "numero_altura_px": { "type": "integer", "minimum": 0, "maximum": 200 },
    "gamepad_limiar": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
    "palco_meia_largura_tiles": { "type": "number", "exclusiveMinimum": 0 },
    "palco_meia_profundidade_tiles": { "type": "number", "exclusiveMinimum": 0 }
  }
}
