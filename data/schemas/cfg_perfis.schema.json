{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dunwick/cfg_perfis",
  "title": "Perfis de qualidade (Alto/Médio/Baixo)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "versao", "padrao", "perfis"],
  "properties": {
    "id": { "const": "cfg_perfis" },
    "versao": { "type": "integer", "minimum": 1 },
    "padrao": { "type": "string", "pattern": "^perfil_[a-z0-9_]+$" },
    "perfis": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "nome_txt", "sombra_sol_px", "luzes_pontuais_max", "luzes_com_sombra", "sombra_pontual_px", "pos_vinheta"],
        "properties": {
          "id": { "type": "string", "pattern": "^perfil_[a-z0-9_]+$" },
          "nome_txt": { "type": "string", "pattern": "^ui_[a-z0-9_]+$" },
          "sombra_sol_px": { "enum": [0, 256, 512, 1024, 2048, 4096] },
          "luzes_pontuais_max": { "type": "integer", "minimum": 0, "maximum": 16 },
          "luzes_com_sombra": { "type": "integer", "minimum": 0, "maximum": 4 },
          "sombra_pontual_px": { "enum": [0, 128, 256, 512, 1024] },
          "pos_vinheta": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
